{
  "name": "@clairvoyant/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json && tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.build.json && node --test \"src/**/*.test.ts\"",
    "lint": "biome lint .",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts up",
    "migrate:down": "tsx --env-file-if-exists=.env src/migrate.ts down"
  },
  "dependencies": {
    "kysely": "^0.29.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

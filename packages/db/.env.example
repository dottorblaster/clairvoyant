# Postgres connection string used by apps/api, apps/indexer and the migration CLI.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Optional. Used ONLY by the integration tests (`pnpm test:integration`).
# Point it at a throwaway database; the suite creates and drops its own
# randomly-named databases inside it, so the developer's `app` database is never
# touched. Tests that need Postgres are skipped when this is unset.
#
#   createdb clairvoyant_test
#   TEST_DATABASE_URL=postgres://app:app@localhost:5432/clairvoyant_test pnpm test:integration
TEST_DATABASE_URL=postgres://app:app@localhost:5432/clairvoyant_test

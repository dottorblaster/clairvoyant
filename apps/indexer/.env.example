# Postgres (derived index).
DATABASE_URL=postgres://app:app@localhost:5432/app

# Jetstream v2 endpoint. The public instance is the default.
JETSTREAM_URL=https://jetstream.us-west.bsky.network

# SECRET. Only apps/indexer reads this. Never expose it to apps/api or apps/web.
# Required by the public Jetstream instance for archive/replay (planSnapshot).
JETSTREAM_API_KEY=

# Where to start when the index is empty (fresh cursor):
#   0        replay the entire retained Jetstream archive (default)
#   <number> resume after an explicit sequence number
#   latest   resolve the current sealed tip and skip historical backfill
# NOTE: Jetstream v2 cursors are sequence numbers, not timestamps, so "last
# year" cannot be expressed here. Once the indexer processes any event the
# cursor is persisted and this value is ignored on later starts.
INDEXER_START_SEQ=0

# Optional. When set, the indexer serves /health and /ready on this port.
# HEALTH_PORT=3001

LOG_LEVEL=info

# --- OpenTelemetry (optional) ----------------------------------------------
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable telemetry entirely: the
# SDK is not even loaded, so there is no startup cost.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=clairvoyant-indexer
# OTEL_SDK_DISABLED=true

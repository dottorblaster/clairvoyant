# Postgres (the derived index).
DATABASE_URL=postgres://app:app@localhost:5432/app

# Jetstream v2 endpoint. Defaults to the public instance.
JETSTREAM_URL=https://jetstream.us-west.bsky.network

# Secret. Only apps/indexer reads this. Never expose it to apps/api or apps/web.
# The public Jetstream instance requires it for the archive and planSnapshot.
JETSTREAM_API_KEY=

# Where to start when the index is empty (fresh cursor):
#   0        replay the whole retained archive (default)
#   <number> resume after an explicit sequence number
#   latest   resolve the current sealed tip and skip history
# Jetstream v2 cursors are sequence numbers, not timestamps, so "last year"
# can't be expressed here. Once the indexer processes any event the cursor is
# persisted and this value is ignored on later starts.
INDEXER_START_SEQ=0

# Optional. When set, the indexer serves /health and /ready on this port.
# HEALTH_PORT=3001

LOG_LEVEL=info

# --- OpenTelemetry (optional) ----------------------------------------------
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable telemetry. The SDK isn't
# loaded at all, so there's no startup cost.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=clairvoyant-indexer
# OTEL_SDK_DISABLED=true

{
  "name": "@clairvoyant/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.build.json && node --test \"src/**/*.test.ts\"",
    "test:coverage": "tsc -p tsconfig.build.json && node --test --experimental-test-coverage \"src/**/*.test.ts\"",
    "lint": "biome lint ."
  },
  "dependencies": {
    "@atproto/api": "^0.22.0",
    "@atproto/oauth-client-node": "^0.5.8",
    "@clairvoyant/db": "workspace:*",
    "@clairvoyant/lexicons": "workspace:*",
    "@clairvoyant/telemetry": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@hono/otel": "^1.2.0",
    "hono": "^4.13.12",
    "kysely": "^0.29.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

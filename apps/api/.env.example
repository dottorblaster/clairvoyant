# Postgres (the derived index).
DATABASE_URL=postgres://app:app@localhost:5432/app

# HTTP port for the API server.
PORT=3000

# "loopback" for local dev (client_id http://localhost, redirect to 127.0.0.1).
# "web" for a deployed HTTPS deployment.
OAUTH_MODE=loopback

# Public HTTPS origin of the API. Required when OAUTH_MODE=web. Used to build the
# OAuth client_id (${PUBLIC_URL}/oauth/client-metadata.json).
PUBLIC_URL=http://localhost:3000

# Where the browser goes after login and logout. In loopback mode this must be
# 127.0.0.1, not localhost: the atproto loopback redirect is pinned to 127.0.0.1
# and cookies are host-scoped (and ignore ports), so the SPA has to be opened on
# the host that receives the callback.
WEB_ORIGIN=http://127.0.0.1:5173

# Secret for the signed httpOnly session cookie (32+ chars). Generate one with
# `openssl rand -base64 48`. The cookie only ever contains the user's DID.
COOKIE_SECRET=change-me-to-a-long-random-string-please

# Optional cookie name override.
COOKIE_NAME=clairvoyant_session

# Force the Secure flag on the session cookie. Defaults to true when
# NODE_ENV=production. Set to false only to run over plain HTTP.
# COOKIE_SECURE=false

LOG_LEVEL=info

# --- OpenTelemetry (optional) ----------------------------------------------
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable telemetry. The SDK isn't
# loaded at all, so there's no startup cost.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=clairvoyant-api
# OTEL_SDK_DISABLED=true

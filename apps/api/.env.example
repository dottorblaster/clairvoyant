# Postgres (derived index).
DATABASE_URL=postgres://app:app@localhost:5432/app

# HTTP port for the API server.
PORT=3000

# "loopback" for local dev (client_id http://localhost, redirect to 127.0.0.1),
# "web" for a deployed HTTPS deployment.
OAUTH_MODE=loopback

# Public HTTPS origin of this API. Required when OAUTH_MODE=web; it is used to
# build the OAuth client_id (${PUBLIC_URL}/oauth/client-metadata.json).
PUBLIC_URL=http://localhost:3000

# Where the browser is sent after login/logout.
# In loopback mode this MUST be 127.0.0.1, not localhost: the atproto loopback
# redirect is pinned to 127.0.0.1 and cookies are host-scoped (and ignore ports),
# so the SPA must be opened at the same host that receives the callback.
WEB_ORIGIN=http://127.0.0.1:5173

# Secret used to sign the httpOnly session cookie (>=32 chars). Generate with
# `openssl rand -base64 48`. The cookie itself only ever contains the user DID.
COOKIE_SECRET=change-me-to-a-long-random-string-please

# Optional cookie name override.
COOKIE_NAME=clairvoyant_session

LOG_LEVEL=info
